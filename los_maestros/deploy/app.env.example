# Copiar a /opt/los-maestros-backend/app.env y completar.
SPRING_PROFILES_ACTIVE=prod
DB_HOST=<endpoint-rds-o-ip-mysql>
DB_NAME=los_maestros
DB_USER=admin
DB_PASSWORD=<contraseña>
# URLs del frontend permitidas por CORS, separadas por coma (S3 y GitHub Pages)
CORS_ORIGIN=http://<bucket>.s3-website-us-east-1.amazonaws.com,https://tomihm.github.io
# Dominio HTTPS que atiende Caddy: la Elastic IP con guiones + .sslip.io (ej: 54-12-34-56.sslip.io)
DOMINIO=<ip-con-guiones>.sslip.io
# Clave para firmar los tokens JWT: mínimo 32 caracteres aleatorios (ej: openssl rand -base64 48)
JWT_SECRET=<clave-larga-y-secreta>
# Administrador que se crea en el primer arranque si no existe ninguno
ADMIN_EMAIL=admin@losmaestros.cl
ADMIN_PASSWORD=<contraseña-del-admin>
