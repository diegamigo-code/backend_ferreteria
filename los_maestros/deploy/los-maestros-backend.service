[Unit]
Description=Los Maestros backend (Spring Boot)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/opt/los-maestros-backend
EnvironmentFile=/opt/los-maestros-backend/app.env
ExecStart=/usr/bin/java -Xmx512m -jar /opt/los-maestros-backend/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
